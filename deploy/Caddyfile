# Le nom de domaine du serveur (certificat HTTPS obtenu et renouvelé automatiquement).
# La connexion des organisateurs est faite par l'application ; Caddy ne tient pas de journal d'accès (les adresses des pages
# des clubs contiennent leur lien personnel).
competitions.shidokanfrance.com {
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		X-Frame-Options "DENY"
		Content-Security-Policy "frame-ancestors 'none'"
		-Server
	}
	reverse_proxy app:3000
}
