{
  "name": "shidokan-tournaments",
  "version": "0.0.0-dev",
  "scripts": {
    "dev": "concurrently -n server,web \"tsx watch src/server/main.ts\" \"vite\"",
    "build": "tsc -p tsconfig.server.json && vite build",
    "start": "node dist/server/main.js",
    "test": "vitest run",
    "test:perf": "vitest run --config vitest.perf.config.ts",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "seed:dev": "tsx scripts/seed-dev.ts"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "private": true,
  "dependencies": {
    "@fastify/static": "^8.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@mantine/core": "^8.3.18",
    "@mantine/dates": "^8.3.18",
    "@mantine/hooks": "^8.3.18",
    "@mantine/notifications": "^8.3.18",
    "@mantine/tiptap": "^8.3.18",
    "@tanstack/react-query": "^5.104.5",
    "@tiptap/extension-file-handler": "^3.32.3",
    "@tiptap/extension-highlight": "^3.32.3",
    "@tiptap/extension-image": "^3.32.3",
    "@tiptap/extension-link": "^3.32.3",
    "@tiptap/extension-text-align": "^3.32.3",
    "@tiptap/extension-text-style": "^3.32.3",
    "@tiptap/pm": "^3.32.3",
    "@tiptap/react": "^3.32.3",
    "@tiptap/starter-kit": "^3.32.3",
    "better-sqlite3": "^13.0.3",
    "dayjs": "^1.11.23",
    "domhandler": "^6.0.1",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "htmlparser2": "^12.0.0",
    "jszip": "^3.10.2",
    "nodemailer": "^10.2.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "5.7.284",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.4",
    "sanitize-html": "^2.18.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^10.0.6",
    "drizzle-kit": "^0.31.11",
    "postcss": "^8.5.31",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  }
}
